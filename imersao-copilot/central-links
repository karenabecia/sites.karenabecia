  <style>
    :root{
      --chat:#d97757;--chat2:#e8956a;--cwork:#7c5cbf;--cwork2:#9b7dd4;--code:#c45c8a;--code2:#d97aaa;
      --green:#4caf7d;--gold:#d4a843;--red:#e07070;--bg:#0c0b0a;--card:#1a1714;--card2:#211e1a;
      --border:#2e2822;--border2:#3d3630;--text:#f0ebe4;--muted:#8a7f74;--muted2:#5e5650;--radius:12px;--hh:64px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;scroll-padding-top:calc(var(--hh) + 12px)}
    body{font-family:'Open Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
    body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:0;opacity:.45}
    body::after{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;z-index:0}
    .wrap{position:relative;z-index:1;max-width:1100px;margin:0 auto;padding:0 24px}
    header{position:sticky;top:0;z-index:100;background:rgba(17,15,13,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--border);height:var(--hh)}
    .header-inner{height:var(--hh);display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:14px}
    .header-inner img{height:42px;max-width:230px;object-fit:contain;flex-shrink:0}
    .logo-text-fb{font-family:'Anton',sans-serif;font-size:1rem;color:var(--text);flex-shrink:0}.logo-text-fb span{color:var(--chat)}
    .header-btns{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .hbtn{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.09em;text-transform:uppercase;padding:7px 14px;border-radius:100px;text-decoration:none;transition:all .2s;white-space:nowrap;border:none;cursor:pointer}
    .hbtn-main{background:var(--chat);color:#fff;border:1px solid var(--chat2)}.hbtn-main:hover{background:var(--chat2);transform:translateY(-1px)}
    .hero{padding:58px 0 40px;text-align:center;position:relative}
    .hero::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:760px;height:320px;background:radial-gradient(ellipse at center,rgba(124,92,191,.16) 0%,rgba(217,119,87,.10) 38%,transparent 72%);pointer-events:none}
    .hero-tag{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.15em;color:var(--muted);text-transform:uppercase;margin-bottom:12px;display:block}
    h1{font-family:'Anton',sans-serif;font-size:clamp(2.2rem,6vw,4.2rem);font-weight:400;line-height:1.04;margin-bottom:14px;letter-spacing:.02em}
    .hero-sub{font-size:.95rem;color:var(--muted);line-height:1.75;max-width:760px;margin:0 auto}
    section{position:relative;z-index:1;padding:44px 0;border-top:1px solid var(--border)}
    .section-label{font-family:'DM Mono',monospace;font-size:.63rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted2);margin-bottom:6px}
    h2{font-family:'Anton',sans-serif;font-size:clamp(1.35rem,3vw,2rem);font-weight:400;letter-spacing:.03em;margin-bottom:22px}
    h3{font-family:'Anton',sans-serif;font-size:1.02rem;font-weight:400;letter-spacing:.02em;margin-bottom:10px}
    p{line-height:1.72}
    .access-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:8px}
    .access-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px 18px;display:flex;flex-direction:column;gap:10px;min-height:220px}
    .access-card h3{margin-bottom:0}.access-card p{color:var(--muted);font-size:.82rem;line-height:1.6;flex:1}.ac-icon{font-size:1.35rem}
    .btn,.material-link{display:inline-flex;align-items:center;justify-content:center;border-radius:100px;padding:10px 14px;font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:all .2s;border:1px solid var(--border2);color:var(--text);background:var(--card2);text-align:center}
    .btn:hover,.material-link:hover{transform:translateY(-1px);border-color:rgba(217,119,87,.5)}
    .btn-teams,.btn-help,.material-link{background:var(--chat);color:#fff;border-color:var(--chat2)}.btn-teams:hover,.btn-help:hover,.material-link:hover{background:var(--chat2)}
    .btn-setup,.material-link.secondary{background:rgba(124,92,191,.18);color:var(--cwork2);border-color:rgba(124,92,191,.35)}
    .schedule-horizontal{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-bottom:26px;align-items:stretch}
    .lesson-card{position:relative;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px 18px;min-height:260px;display:flex;flex-direction:column;gap:10px;overflow:hidden}
    .lesson-card::before{content:'';position:absolute;inset:0 auto 0 0;width:3px;background:var(--border2)}
    .lesson-card.next{border-color:rgba(217,119,87,.35);background:rgba(217,119,87,.05)}.lesson-card.next::before{background:var(--chat)}
    .lesson-card.soon{border-color:rgba(124,92,191,.28);background:rgba(124,92,191,.05)}.lesson-card.soon::before{background:var(--cwork)}
    .lesson-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
    .lesson-date{font-family:'DM Mono',monospace;color:var(--chat);line-height:1}.lesson-card.soon .lesson-date{color:var(--cwork2)}
    .lesson-date strong{display:block;font-family:'Anton',sans-serif;font-size:1.8rem;font-weight:400}.lesson-date span{display:block;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:4px}
    .lesson-status{font-family:'DM Mono',monospace;font-size:.56rem;letter-spacing:.08em;text-transform:uppercase;border-radius:999px;padding:5px 9px;white-space:nowrap;color:var(--chat);background:rgba(217,119,87,.15);border:1px solid rgba(217,119,87,.3)}
    .lesson-card.soon .lesson-status{color:var(--cwork2);background:rgba(124,92,191,.15);border-color:rgba(124,92,191,.32)}
    .lesson-card h3{font-size:1.06rem;line-height:1.25;margin:0}.lesson-card p{font-size:.84rem;color:var(--muted);line-height:1.58;flex:1}
    .next-reminder{background:linear-gradient(135deg,rgba(217,119,87,.10),rgba(124,92,191,.08));border:1px solid var(--border2);border-radius:var(--radius);padding:18px;display:flex;gap:14px;align-items:flex-start}
    .reminder-icon{font-size:1.3rem;flex-shrink:0}.next-reminder h3{margin-bottom:4px}.next-reminder p{font-size:.84rem;color:var(--muted)}
    footer{position:relative;z-index:1;border-top:1px solid var(--border);padding:24px 0 28px;text-align:center;margin-top:48px}footer p{font-size:.78rem;color:var(--muted2)}
